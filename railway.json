{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": null
  },
  "deploy": {
    "preDeployCommand": null,
    "startCommand": "gunicorn --bind 0.0.0.0:$PORT wsgi:app",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}